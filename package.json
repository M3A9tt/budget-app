    "login:cloudflare": "wrangler login --device --browser=false",
    "test:browser": "node scripts/check-finance-browser.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "react-test-renderer": "^18.2.0",
    "vite": "^6.4.4",
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": ">=24"
  }
}
