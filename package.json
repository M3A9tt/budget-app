{
  "name": "finance-app",
  "private": true,
  "version": "3.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "demo": "node scripts/build-preview.mjs",
    "worker:check": "node scripts/check-worker.mjs",
    "deploy:staging": "wrangler deploy --config server/wrangler.staging.jsonc",
    "db:staging": "wrangler d1 execute budget-staging --remote --file server/schema.sql --config server/wrangler.staging.jsonc",
    "login:cloudflare": "wrangler login --device --browser=false"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.4.0",
    "wrangler": "4.119.0",
    "esbuild": "^0.21.5"
  },
  "engines": {
    "node": ">=24"
  }
}
