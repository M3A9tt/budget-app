{
  "name": "finance-app",
  "private": true,
  "version": "5.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "demo": "node scripts/build-preview.mjs",
    "worker:check": "node scripts/check-worker.mjs",
    "deploy:staging": "wrangler deploy --config server/wrangler.staging.jsonc",
    "db:staging": "wrangler d1 execute budget-staging --remote --file server/schema.sql --config server/wrangler.staging.jsonc",
    "login:cloudflare": "wrangler login --device --browser=false",
    "test:browser": "node scripts/check-finance-browser.mjs",
    "test:reliability": "node scripts/check-reliability-browser.mjs",
    "test:usability": "node scripts/check-intuitive-browser.mjs",
    "test:payments": "node scripts/check-payment-experience.mjs",
    "test:ondemand": "node scripts/check-on-demand-browser.mjs",
    "test:calendar": "node scripts/check-connected-calendar.mjs",
    "test:personal": "node scripts/check-personal-interface.mjs",
    "test:entry": "node scripts/check-unified-entry.mjs",
    "test:layout": "node scripts/check-entry-layout.mjs",
    "test:bot-cards": "node scripts/check-bot-cards.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "react-test-renderer": "^18.2.0",
    "vite": "^6.4.4",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=24"
  }
}
